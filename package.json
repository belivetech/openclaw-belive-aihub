    "openclaw": "2026.11.1",
    "typescript": "5.9.3",
    "@types/node": "26.6.4"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "install": { "minHostVersion": ">=2026.11.1" },
    "compat": { "pluginApi": ">=2026.11.1" },
    "build": { "openclawVersion": "2026.11.1", "bundledDist": false }
  }
}
