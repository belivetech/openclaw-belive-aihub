{
  "name": "@belivetech/openclaw-belive-aihub",
  "version": "0.1.4",
  "description": "BeLive AI Hub model provider for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": "BeLive Technology",
  "repository": { "type": "git", "url": "https://github.com/belivetech/openclaw-belive-aihub.git" },
  "files": ["dist", "openclaw.plugin.json", "README.md", "VALIDATION.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": { "node": ">=24.16.0 <25 || >=26.1.0" },
  "peerDependencies": { "openclaw": ">=2026.11.1 <2027" },
