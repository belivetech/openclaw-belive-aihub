{
  "id": "belive-aihub",
  "name": "BeLive AI Hub",
  "description": "BeLive AI Hub model provider, with image, video and speech generation and media understanding, for OpenClaw",
  "categories": ["models"],
  "providers": ["belive-aihub"],
  "contracts": {
    "imageGenerationProviders": ["belive-aihub"],
    "videoGenerationProviders": ["belive-aihub"],
    "speechProviders": ["belive-aihub"],
    "mediaUnderstandingProviders": ["belive-aihub"]
  },
  "mediaUnderstandingProviderMetadata": {
    "belive-aihub": {
      "capabilities": ["image", "video"],
      "defaultModels": { "image": "qwen/qwen3.8-flash", "video": "qwen/qwen3.8-flash" }
    }
  },
  "providerEndpoints": [{
    "endpointClass": "belive-aihub",
    "hosts": ["tokenhub-api.belive.sg", "api-stg-tokenhub.belive.sg"]
  }],
  "setup": { "providers": [{ "id": "belive-aihub", "envVars": ["BELIVE_TOKENHUB_API_KEY"] }] },
  "providerAuthChoices": [{
    "provider": "belive-aihub",
    "method": "api-key",
    "choiceId": "belive-aihub-api-key",
    "choiceLabel": "BeLive AI Hub API key",
    "groupId": "belive-aihub",
    "groupLabel": "BeLive AI Hub",
    "cliFlag": "--belive-aihub-api-key",
    "cliOption": "--belive-aihub-api-key <key>",
    "cliDescription": "BeLive AI Hub workspace inference key"
  }],
  "configSchema": { "type": "object", "additionalProperties": false, "properties": {} }
}
